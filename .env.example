ADMIN_KEY=請設定一組安全的後台密碼
CORS_ORIGIN=https://你的帳號.github.io
PUBLIC_SITE_URL=https://你的帳號.github.io/qing/

# 免費 Web Push（VAPID 私鑰只設定於 Worker，不可提交至版本庫）
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:service@example.com

# 選用：叫號 Twilio 簡訊
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# 選用：叫號簡訊供應商 Webhook（接收 JSON POST）
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
